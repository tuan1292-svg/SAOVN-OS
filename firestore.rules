rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membershipId() { return "mem_" + request.auth.uid + "_org_saovn_01"; }
    function isMember() { return signedIn() && exists(/databases/$(database)/documents/memberships/$(membershipId())); }
    function membership() { return get(/databases/$(database)/documents/memberships/$(membershipId())).data; }
    function hasOrgRole(roleName) { return isMember() && membership().roles != null && membership().roles.organization != null && roleName in membership().roles.organization; }
    function hasSystemRole(roleName) { return isMember() && membership().roles != null && membership().roles.system != null && roleName in membership().roles.system; }
    function isSystemAdmin() { return hasSystemRole("system_admin") || hasSystemRole("admin"); }
    function isAdmin() { return isSystemAdmin() || hasOrgRole("org_admin") || hasOrgRole("organization_admin") || hasOrgRole("admin"); }
    function isManager() { return hasOrgRole("manager") || hasOrgRole("org_manager"); }
    function isPrivileged() { return isAdmin() || isManager(); }

    // Keep the Firestore security model aligned with the Core permission matrix.
    // The application permission engine cannot be imported into Rules, so the same
    // role-to-permission decisions are expressed here at the security boundary.
    function canReadMembers() { return isAdmin(); }
    function canCreateMembers() { return isAdmin(); }
    function canUpdateMembers() { return isAdmin(); }
    function canManageMemberRoles() { return isAdmin(); }
    function canDeleteMembers() { return isAdmin(); }

    function canReadWork() { return isMember(); }
    function canCreateWork() { return isMember(); }
    function canEditWork() { return isMember(); }
    function canDeleteWork() { return isAdmin() || isManager(); }
    function canAssignWork() { return isAdmin() || isManager(); }

    function taskAssigneeIds(data) { return data.get("assigneeIds", []); }
    function taskAssigneeId(data) { return data.get("assigneeId", ""); }

    function canReadTask(taskId) {
      return isPrivileged() || (isMember() && (
        get(/databases/$(database)/documents/workTasks/$(taskId)).data.get("createdBy", "") == request.auth.uid
        || request.auth.uid in get(/databases/$(database)/documents/workTasks/$(taskId)).data.get("assigneeIds", [])
        || get(/databases/$(database)/documents/workTasks/$(taskId)).data.get("assigneeId", "") == request.auth.uid
      ));
    }

    match /identities/{userId} {
      // Identity directory is intentionally broader than the Members admin module:
      // active members may resolve names for work assignment/collaboration, but only
      // the account owner or Admin may access the full identity record.
      allow read: if signedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || (isMember() && resource.data.status == "ACTIVE")
      );
      allow create, update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /memberships/{membershipDocId} {
      // A member can read only their own membership. The Members administration
      // module is Admin-only, matching members.view/manage in the Core matrix.
      allow read: if signedIn() && (membershipDocId == membershipId() || canReadMembers());
      allow create: if canCreateMembers() || (
        signedIn()
        && membershipDocId == membershipId()
        && request.resource.data.status == "ACTIVE"
        && request.resource.data.identityId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.organizationId == "org_saovn_01"
        && request.resource.data.invitationId is string
        && exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId))
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == "PENDING"
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.organizationId == "org_saovn_01"
      );
      allow update: if canUpdateMembers() || (
        signedIn()
        && membershipDocId == membershipId()
        && resource.data.status == "PENDING"
        && request.resource.data.status == "ACTIVE"
        && request.resource.data.identityId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.organizationId == "org_saovn_01"
      );
      allow delete: if canDeleteMembers();
    }

    match /invitations/{invitationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == "PENDING" && resource.data.email == request.auth.token.email);
      allow create: if isAdmin() && request.resource.data.organizationId == "org_saovn_01" && request.resource.data.invitedBy == request.auth.uid && request.resource.data.status == "PENDING" && request.resource.data.email is string && request.resource.data.role in ["MEMBER", "MANAGER", "ADMIN"];
      allow update: if isAdmin() || (signedIn() && resource.data.status == "PENDING" && resource.data.email == request.auth.token.email && request.resource.data.status == "ACCEPTED" && request.resource.data.acceptedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /workTasks/{taskId} {
      allow read: if canReadWork() && (
        isPrivileged()
        || resource.data.get("createdBy", "") == request.auth.uid
        || request.auth.uid in resource.data.get("assigneeIds", [])
        || resource.data.get("assigneeId", "") == request.auth.uid
      );
      allow create: if canCreateWork() && (
        isPrivileged()
        || request.resource.data.get("createdBy", "") == request.auth.uid
        || request.auth.uid in request.resource.data.get("assigneeIds", [])
        || request.resource.data.get("assigneeId", "") == request.auth.uid
      );
      allow update: if canEditWork() && (
        isPrivileged()
        || resource.data.get("createdBy", "") == request.auth.uid
        || request.resource.data.get("createdBy", "") == request.auth.uid
        || request.auth.uid in resource.data.get("assigneeIds", [])
        || request.auth.uid in request.resource.data.get("assigneeIds", [])
        || resource.data.get("assigneeId", "") == request.auth.uid
        || request.resource.data.get("assigneeId", "") == request.auth.uid
      );
      allow delete: if canDeleteWork();

      match /comments/{commentId} {
        allow read, create: if canReadTask(taskId);
        allow update, delete: if canReadTask(taskId) && (resource.data.authorId == request.auth.uid || isPrivileged());
      }
      match /checklist/{itemId} {
        allow read, create, update, delete: if canReadTask(taskId);
      }
      match /activity/{activityId} {
        allow read, create: if canReadTask(taskId);
        allow update, delete: if canReadTask(taskId) && isPrivileged();
      }
    }

    match /projects/{projectId} { allow read: if isMember(); allow create, update: if isPrivileged(); allow delete: if isAdmin(); }
    match /projects/{projectId}/members/{memberId} { allow read: if isMember(); allow create, update, delete: if isPrivileged(); }
    match /projects/{projectId}/activity/{activityId} { allow read, create: if isMember(); allow update, delete: if isPrivileged(); }
    match /notifications/{userId} { allow read, create, update, delete: if signedIn() && (request.auth.uid == userId || isPrivileged()); match /items/{notificationId} { allow read, create, update, delete: if signedIn() && (request.auth.uid == userId || isPrivileged()); } }
    match /departments/{departmentId} { allow read: if isMember(); allow create, update: if isPrivileged(); allow delete: if isAdmin(); }
    match /roles/{roleId} { allow read: if isMember(); allow create, update, delete: if isAdmin(); }
    match /documents/{documentId} { allow read: if isMember(); allow create, update: if isPrivileged(); allow delete: if isAdmin(); }
    match /system/{documentId} { allow read, create, update, delete: if isSystemAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}