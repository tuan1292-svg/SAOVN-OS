rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membershipId() { return "mem_" + request.auth.uid + "_org_saovn_01"; }
    function isMember() { return signedIn() && exists(/databases/$(database)/documents/memberships/$(membershipId())); }
    function membership() { return get(/databases/$(database)/documents/memberships/$(membershipId())).data; }
    function hasOrgRole(roleName) { return isMember() && membership().roles != null && membership().roles.organization != null && roleName in membership().roles.organization; }
    function hasSystemRole(roleName) { return isMember() && membership().roles != null && membership().roles.system != null && roleName in membership().roles.system; }
    function isSystemAdmin() { return hasSystemRole("system_admin") || hasSystemRole("admin"); }
    function isAdmin() { return isSystemAdmin() || hasOrgRole("org_admin") || hasOrgRole("organization_admin") || hasOrgRole("admin"); }
    function isManager() { return hasOrgRole("manager") || hasOrgRole("org_manager"); }
    function isTeamLead() { return hasOrgRole("team_lead") || hasOrgRole("team_leader"); }
    function currentDepartmentId() { return isMember() ? membership().get("departmentId", "") : ""; }
    function currentDepartment() { return isMember() ? membership().get("department", "") : ""; }
    function currentTeamId() { return isMember() ? membership().get("teamId", "") : ""; }
    function currentTeam() { return isMember() ? membership().get("team", "") : ""; }
    function isDepartmentHead() {
      return isMember()
        && currentDepartmentId() != ""
        && exists(/databases/$(database)/documents/departments/$(currentDepartmentId()))
        && get(/databases/$(database)/documents/departments/$(currentDepartmentId())).data.get("headId", "") == request.auth.uid;
    }
    function isPrivileged() { return isAdmin() || isManager() || isTeamLead() || isDepartmentHead(); }
    function isWorkManager() { return isAdmin() || isManager() || isDepartmentHead() || isTeamLead(); }

    function taskInDepartment(data) {
      return (currentDepartmentId() != "" && data.get("departmentId", "") == currentDepartmentId())
        || (currentDepartment() != "" && data.get("department", "") == currentDepartment());
    }
    function taskInTeam(data) {
      return (currentTeamId() != "" && data.get("teamId", "") == currentTeamId())
        || (currentTeam() != "" && data.get("team", "") == currentTeam());
    }
    function taskInManagementScope(data) {
      return isAdmin()
        || ((isManager() || isDepartmentHead()) && taskInDepartment(data))
        || (isTeamLead() && taskInTeam(data));
    }
    function taskOwnedByCurrentUser(data) { return data.get("createdBy", "") == request.auth.uid; }
    function taskAssignedToCurrentUser(data) { return request.auth.uid in data.get("assigneeIds", []) || data.get("assigneeId", "") == request.auth.uid; }

    function canReadMembers() { return isAdmin(); }
    function canCreateMembers() { return isAdmin(); }
    function canUpdateMembers() { return isAdmin(); }
    function canManageMemberRoles() { return isAdmin(); }
    function canDeleteMembers() { return isAdmin(); }

    function canReadWork() { return isMember(); }
    function canCreateWork() { return isMember(); }
    function canEditWork() { return isMember(); }
    function canDeleteWork() { return isWorkManager(); }
    function canAssignWork() { return isWorkManager(); }

    function canReadTaskData(data) {
      return taskInManagementScope(data) || taskOwnedByCurrentUser(data) || taskAssignedToCurrentUser(data);
    }
    function canCreateTaskData(data) {
      return isAdmin()
        || ((isManager() || isDepartmentHead()) && taskInDepartment(data))
        || (isTeamLead() && taskInTeam(data))
        || (isMember() && taskOwnedByCurrentUser(data) && (
          data.get("assigneeIds", []) == []
          || (data.get("assigneeIds", []) is list && data.get("assigneeIds", []).size() == 1 && request.auth.uid in data.get("assigneeIds", []))
          || data.get("assigneeId", "") == ""
          || data.get("assigneeId", "") == request.auth.uid
        ));
    }
    function canUpdateTaskData(oldData, newData) {
      return isAdmin()
        || ((isManager() || isDepartmentHead()) && taskInDepartment(oldData) && taskInDepartment(newData))
        || (isTeamLead() && taskInTeam(oldData) && taskInTeam(newData))
        || (isMember() && (taskOwnedByCurrentUser(oldData) || taskAssignedToCurrentUser(oldData))
          && newData.get("createdBy", "") == oldData.get("createdBy", "")
          && newData.get("assigneeIds", []) == oldData.get("assigneeIds", [])
          && newData.get("assigneeId", "") == oldData.get("assigneeId", ""));
    }
    function canDeleteTaskData(data) {
      return isAdmin()
        || ((isManager() || isDepartmentHead()) && taskInDepartment(data))
        || (isTeamLead() && taskInTeam(data));
    }

    match /identities/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || (isMember() && resource.data.status == "ACTIVE"));
      allow create, update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /memberships/{membershipDocId} {
      allow read: if signedIn() && (membershipDocId == membershipId() || canReadMembers());
      allow create: if canCreateMembers() || (signedIn() && membershipDocId == membershipId() && request.resource.data.status == "ACTIVE" && request.resource.data.identityId == request.auth.uid && request.resource.data.userId == request.auth.uid && request.resource.data.organizationId == "org_saovn_01" && request.resource.data.invitationId is string && exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)) && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == "PENDING" && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.email == request.auth.token.email && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.organizationId == "org_saovn_01");
      allow update: if canUpdateMembers() || (signedIn() && membershipDocId == membershipId() && resource.data.status == "PENDING" && request.resource.data.status == "ACTIVE" && request.resource.data.identityId == request.auth.uid && request.resource.data.userId == request.auth.uid && request.resource.data.organizationId == "org_saovn_01");
      allow delete: if canDeleteMembers();
    }

    match /invitations/{invitationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == "PENDING" && resource.data.email == request.auth.token.email);
      allow create: if isAdmin() && request.resource.data.organizationId == "org_saovn_01" && request.resource.data.invitedBy == request.auth.uid && request.resource.data.status == "PENDING" && request.resource.data.email is string && request.resource.data.role in ["MEMBER", "MANAGER", "ADMIN"];
      allow update: if isAdmin() || (signedIn() && resource.data.status == "PENDING" && resource.data.email == request.auth.token.email && request.resource.data.status == "ACCEPTED" && request.resource.data.acceptedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /workTasks/{taskId} {
      allow read: if canReadWork() && canReadTaskData(resource.data);
      allow create: if canCreateWork() && canCreateTaskData(request.resource.data);
      allow update: if canEditWork() && canUpdateTaskData(resource.data, request.resource.data);
      allow delete: if canDeleteWork() && canDeleteTaskData(resource.data);

      match /comments/{commentId} {
        allow read, create: if canReadTaskData(get(/databases/$(database)/documents/workTasks/$(taskId)).data);
        allow update, delete: if canReadTaskData(get(/databases/$(database)/documents/workTasks/$(taskId)).data) && (resource.data.authorId == request.auth.uid || isPrivileged());
      }
      match /checklist/{itemId} {
        allow read, create, update, delete: if canReadTaskData(get(/databases/$(database)/documents/workTasks/$(taskId)).data);
      }
      match /activity/{activityId} {
        allow read, create: if canReadTaskData(get(/databases/$(database)/documents/workTasks/$(taskId)).data);
        allow update, delete: if canReadTaskData(get(/databases/$(database)/documents/workTasks/$(taskId)).data) && isPrivileged();
      }
    }

    match /projects/{projectId} { allow read: if isMember(); allow create, update: if isPrivileged(); allow delete: if isAdmin(); }
    match /projects/{projectId}/members/{memberId} { allow read: if isMember(); allow create, update, delete: if isPrivileged(); }
    match /projects/{projectId}/activity/{activityId} { allow read, create: if isMember(); allow update, delete: if isPrivileged(); }
    match /notifications/{userId} { allow read, create, update, delete: if signedIn() && (request.auth.uid == userId || isPrivileged()); match /items/{notificationId} { allow read, create, update, delete: if signedIn() && (request.auth.uid == userId || isPrivileged()); } }

    match /departments/{departmentId} {
      allow read: if isMember();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /roles/{roleId} { allow read: if isMember(); allow create, update, delete: if isAdmin(); }
    match /documents/{documentId} { allow read: if isMember(); allow create, update: if isPrivileged(); allow delete: if isAdmin(); }
    match /system/{documentId} { allow read, create, update, delete: if isSystemAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}