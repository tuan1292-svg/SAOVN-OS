rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membershipId() { return "mem_" + request.auth.uid + "_org_saovn_01"; }
    function isActive(data) { return data.get("status", "") == "ACTIVE" || data.get("status", "") == "active"; }
    function isMember() { return signedIn() && exists(/databases/$(database)/documents/memberships/$(membershipId())); }
    function membership() { return get(/databases/$(database)/documents/memberships/$(membershipId())).data; }
    function hasOrgRole(r) { return isMember() && membership().roles != null && membership().roles.organization != null && r in membership().roles.organization; }
    function hasSystemRole(r) { return isMember() && membership().roles != null && membership().roles.system != null && r in membership().roles.system; }
    function isSystemAdmin() { return hasSystemRole("system_admin") || hasSystemRole("admin") || hasSystemRole("ADMIN") || hasSystemRole("SYSTEM_ADMIN"); }
    function isAdmin() { return isSystemAdmin() || hasOrgRole("org_admin") || hasOrgRole("organization_admin") || hasOrgRole("admin") || hasOrgRole("ADMIN") || hasOrgRole("ORG_ADMIN") || hasOrgRole("ORGANIZATION_ADMIN"); }
    // Position is not a UI role. These organizational positions only contribute
    // management scope to backend policy when the membership stores them directly.
    function isManager() { return hasOrgRole("manager") || hasOrgRole("org_manager") || hasOrgRole("MANAGER") || hasOrgRole("ORG_MANAGER") || hasOrgRole("director") || hasOrgRole("DIRECTOR") || hasOrgRole("executive") || hasOrgRole("EXECUTIVE") || hasOrgRole("ceo") || hasOrgRole("CEO") || hasOrgRole("cfo") || hasOrgRole("CFO") || hasOrgRole("cto") || hasOrgRole("CTO") || hasOrgRole("coo") || hasOrgRole("COO") || hasOrgRole("chro") || hasOrgRole("CHRO") || hasOrgRole("cmo") || hasOrgRole("CMO") || hasOrgRole("vice_president") || hasOrgRole("VICE_PRESIDENT") || hasOrgRole("vp") || hasOrgRole("VP"); }
    function isTeamLead() { return hasOrgRole("team_lead") || hasOrgRole("team_leader") || hasOrgRole("TEAM_LEAD") || hasOrgRole("TEAM_LEADER"); }
    function departmentId() { return isMember() ? membership().get("departmentId", "") : ""; }
    function departmentName() { return isMember() ? membership().get("department", "") : ""; }
    function teamId() { return isMember() ? membership().get("teamId", "") : ""; }
    function teamName() { return isMember() ? membership().get("team", "") : ""; }
    function isDepartmentHead() { return isMember() && departmentId() != "" && exists(/databases/$(database)/documents/departments/$(departmentId())) && get(/databases/$(database)/documents/departments/$(departmentId())).data.get("headId", "") == request.auth.uid; }
    function isPrivileged() { return isAdmin() || isManager() || isTeamLead() || isDepartmentHead(); }
    function isWorkManager() { return isAdmin() || isManager() || isTeamLead() || isDepartmentHead(); }

    function taskInDepartment(data) { return (departmentId() != "" && data.get("departmentId", "") == departmentId()) || (departmentName() != "" && data.get("department", "") == departmentName()); }
    function taskInTeam(data) { return (teamId() != "" && data.get("teamId", "") == teamId()) || (teamName() != "" && data.get("team", "") == teamName()); }
    function taskOwned(data) { return data.get("createdBy", "") == request.auth.uid; }
    function taskAssigned(data) { return request.auth.uid in data.get("assigneeIds", []); }
    function taskLegacyAssigned(data) { return data.get("assigneeId", "") == request.auth.uid; }
    function taskManaged(data) { return isAdmin() || ((isManager() || isDepartmentHead()) && taskInDepartment(data)) || (isTeamLead() && taskInTeam(data)); }
    function taskMemberScope(data) { return isMember() && (taskInDepartment(data) || taskInTeam(data)); }
    function taskReadable(data) { return isMember() && (taskManaged(data) || taskMemberScope(data) || taskOwned(data) || taskAssigned(data) || taskLegacyAssigned(data)); }
    function taskStatusOnly(oldData, newData) { return isMember() && (taskAssigned(oldData) || taskLegacyAssigned(oldData) || taskOwned(oldData)) && newData.diff(oldData).affectedKeys().hasOnly(["status", "updatedAt", "updatedBy"]); }
    function taskMemberUpdate(oldData, newData) { return isMember() && (taskAssigned(oldData) || taskLegacyAssigned(oldData) || taskOwned(oldData)) && newData.diff(oldData).affectedKeys().hasOnly(["title", "description", "dueDate", "status", "priority", "updatedAt", "updatedBy"]); }
    function taskManagedUpdate(oldData, newData) { return isAdmin() || ((isManager() || isDepartmentHead()) && taskInDepartment(oldData) && taskInDepartment(newData)) || (isTeamLead() && taskInTeam(oldData) && taskInTeam(newData)); }
    function taskChildReadable(data) { return taskReadable(data); }
    function canReadWorkChat(data) { return taskChildReadable(data); }
    function canWriteWorkChat(data) { return taskChildReadable(data) && isMember(); }

    match /identities/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    match /memberships/{membershipDocId} {
      allow read: if signedIn() && (membershipDocId == membershipId() || isAdmin() || isManager() || isActive(resource.data));
      allow create: if isAdmin() || (signedIn() && membershipDocId == membershipId() && isActive(request.resource.data) && request.resource.data.identityId == request.auth.uid && request.resource.data.userId == request.auth.uid && request.resource.data.organizationId == "org_saovn_01");
      allow update: if isAdmin() || (signedIn() && membershipDocId == membershipId() && resource.data.status in ["PENDING", "pending"] && isActive(request.resource.data) && request.resource.data.identityId == request.auth.uid && request.resource.data.userId == request.auth.uid && request.resource.data.organizationId == "org_saovn_01");
      allow delete: if isAdmin();
    }
    match /invitations/{invitationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == "PENDING" && resource.data.email == request.auth.token.email);
      allow create: if isAdmin() && request.resource.data.organizationId == "org_saovn_01" && request.resource.data.invitedBy == request.auth.uid && request.resource.data.status == "PENDING" && request.resource.data.email is string && request.resource.data.role in ["MEMBER", "MANAGER", "ADMIN"];
      allow update: if isAdmin() || (signedIn() && resource.data.status == "PENDING" && request.resource.data.status == "ACCEPTED" && request.resource.data.acceptedBy == request.auth.uid && request.resource.data.email == request.auth.token.email);
      allow delete: if isAdmin();
    }

    match /departments/{departmentId} { allow read: if isMember(); allow create, update, delete: if isAdmin(); }
    match /roles/{roleId} { allow read: if isMember(); allow create, update, delete: if isAdmin(); }
    match /system/{documentId} { allow read, create, update, delete: if isSystemAdmin(); }
    match /systemConfig/{configId} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }

    match /attendanceSessions/{sessionId} {
      allow read: if isMember() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isMember() && request.resource.data.userId == request.auth.uid;
      allow update: if isMember() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /attendanceDays/{attendanceId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.userId == request.auth.uid && request.resource.data.organizationId == "org_saovn_01";
      allow update: if isMember() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && request.resource.data.organizationId == resource.organizationId;
      allow delete: if isAdmin();
    }
    match /documents/{documentId} { allow read: if isMember(); allow create, update: if isPrivileged(); allow delete: if isAdmin(); }

    match /workTasks/{taskId} {
      allow read: if isMember() && taskAssigned(resource.data);
      allow read: if isMember() && taskLegacyAssigned(resource.data);
      allow read: if isMember() && taskOwned(resource.data);
      allow read: if isMember() && taskManaged(resource.data);
      allow read: if isMember() && taskMemberScope(resource.data);
      allow create: if isMember() && (isAdmin() || ((isManager() || isDepartmentHead()) && taskInDepartment(request.resource.data)) || (isTeamLead() && taskInTeam(request.resource.data)) || (taskOwned(request.resource.data) && (request.resource.data.get("assigneeIds", []) == [] || request.resource.data.get("assigneeId", "") == "" || request.auth.uid in request.resource.data.get("assigneeIds", []) || request.resource.data.get("assigneeId", "") == request.auth.uid)));
      allow update: if taskManagedUpdate(resource.data, request.resource.data) || taskMemberUpdate(resource.data, request.resource.data) || taskStatusOnly(resource.data, request.resource.data);
      allow delete: if isWorkManager() && taskManaged(resource.data);
      match /comments/{commentId} {
        allow read: if taskChildReadable(get(/databases/$(database)/documents/workTasks/$(taskId)).data);
        allow create: if taskChildReadable(get(/databases/$(database)/documents/workTasks/$(taskId)).data) && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if taskChildReadable(get(/databases/$(database)/documents/workTasks/$(taskId)).data) && (resource.data.authorId == request.auth.uid || isPrivileged());
      }
      match /checklist/{itemId} {
        allow read: if taskChildReadable(get(/databases/$(database)/documents/workTasks/$(taskId)).data);
        allow create, update, delete: if taskChildReadable(get(/databases/$(database)/documents/workTasks/$(taskId)).data);
      }
      match /activity/{activityId} {
        allow read, create: if taskChildReadable(get(/databases/$(database)/documents/workTasks/$(taskId)).data);
        allow update, delete: if taskChildReadable(get(/databases/$(database)/documents/workTasks/$(taskId)).data) && isPrivileged();
      }
      match /chat/{messageId} {
        allow read: if canReadWorkChat(get(/databases/$(database)/documents/workTasks/$(taskId)).data);
        allow create: if canWriteWorkChat(get(/databases/$(database)/documents/workTasks/$(taskId)).data) && request.resource.data.senderId == request.auth.uid && request.resource.data.taskId == taskId;
        allow update, delete: if canWriteWorkChat(get(/databases/$(database)/documents/workTasks/$(taskId)).data) && resource.data.senderId == request.auth.uid;
      }
    }

    match /projects/{projectId} { allow read: if isMember(); allow create, update: if isPrivileged(); allow delete: if isAdmin(); }
    match /projects/{projectId}/members/{memberId} { allow read: if isMember(); allow create, update, delete: if isPrivileged(); }
    match /projects/{projectId}/activity/{activityId} { allow read, create: if isMember(); allow update, delete: if isPrivileged(); }
    function isConversationMember(data) { return isMember() && request.auth.uid in data.get("memberIds", []); }
    function canCreateDirectConversation(data) { return isMember() && data.get("type", "") == "direct" && data.get("memberIds", []) is list && data.get("memberIds", []).size() == 2 && request.auth.uid in data.get("memberIds", []); }
    match /conversations/{conversationId} {
      allow read: if isConversationMember(resource.data);
      allow create: if canCreateDirectConversation(request.resource.data);
      allow update: if isConversationMember(resource.data) && request.auth.uid in request.resource.data.memberIds;
      allow delete: if isAdmin();
      match /messages/{messageId} {
        allow read: if isConversationMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if isConversationMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isConversationMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data) && resource.data.senderId == request.auth.uid;
      }
    }
    match /notifications/{userId} {
      allow read, create, update, delete: if signedIn() && (request.auth.uid == userId || isPrivileged());
      match /items/{notificationId} {
        allow read, update, delete: if signedIn() && (request.auth.uid == userId || isPrivileged());
        allow create: if signedIn() && (request.auth.uid == userId || isPrivileged());
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}