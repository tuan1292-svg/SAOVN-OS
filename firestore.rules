rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membershipId() { return "mem_" + request.auth.uid + "_org_saovn_01"; }
    function isMember() { return signedIn() && exists(/databases/$(database)/documents/memberships/$(membershipId())); }
    function membership() { return get(/databases/$(database)/documents/memberships/$(membershipId())).data; }
    function hasRole(roleName) { return isMember() && membership().roles != null && membership().roles.organization != null && roleName in membership().roles.organization; }
    function isSystemAdmin() { return isMember() && membership().roles != null && membership().roles.system != null && ("system_admin" in membership().roles.system || "admin" in membership().roles.system); }
    function isAdmin() { return isSystemAdmin() || hasRole("org_admin") || hasRole("organization_admin") || hasRole("admin"); }
    function isManager() { return hasRole("manager") || hasRole("org_manager"); }
    function isPrivileged() { return isAdmin() || isManager(); }
    function canReadTask(taskId) { return isPrivileged() || (isMember() && (
      get(/databases/$(database)/documents/workTasks/$(taskId)).data.createdBy == request.auth.uid
      || (get(/databases/$(database)/documents/workTasks/$(taskId)).data.assigneeIds is list && request.auth.uid in get(/databases/$(database)/documents/workTasks/$(taskId)).data.assigneeIds)
      || get(/databases/$(database)/documents/workTasks/$(taskId)).data.assigneeId == request.auth.uid
    )); }

    match /identities/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isPrivileged() || (isMember() && resource.data.status == "ACTIVE"));
      allow create, update: if signedIn() && (request.auth.uid == userId || isPrivileged());
      allow delete: if isAdmin();
    }

    match /memberships/{membershipDocId} {
      allow read: if signedIn() && (membershipDocId == membershipId() || isPrivileged() || (isMember() && resource.data.status == "ACTIVE"));
      allow create: if isAdmin() || (
        signedIn()
        && membershipDocId == membershipId()
        && request.resource.data.status == "ACTIVE"
        && request.resource.data.identityId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.organizationId == "org_saovn_01"
        && request.resource.data.invitationId is string
        && exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId))
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == "PENDING"
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.organizationId == "org_saovn_01"
      );
      allow update: if isAdmin() || (
        signedIn()
        && membershipDocId == membershipId()
        && resource.data.status == "PENDING"
        && request.resource.data.status == "ACTIVE"
        && request.resource.data.identityId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.organizationId == "org_saovn_01"
      );
      allow delete: if isAdmin();
    }

    match /invitations/{invitationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == "PENDING" && resource.data.email == request.auth.token.email);
      allow create: if isAdmin() && request.resource.data.organizationId == "org_saovn_01" && request.resource.data.invitedBy == request.auth.uid && request.resource.data.status == "PENDING" && request.resource.data.email is string && request.resource.data.role in ["MEMBER", "MANAGER", "ADMIN"];
      allow update: if isAdmin() || (signedIn() && resource.data.status == "PENDING" && resource.data.email == request.auth.token.email && request.resource.data.status == "ACCEPTED" && request.resource.data.acceptedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /workTasks/{taskId} {
      // Admin/Manager: entire workspace. Member: only assigned or self-created tasks.
      allow read: if isPrivileged() || (isMember() && (resource.data.createdBy == request.auth.uid || (resource.data.assigneeIds is list && request.auth.uid in resource.data.assigneeIds) || resource.data.assigneeId == request.auth.uid));
      allow create: if isMember() && (isPrivileged() || request.resource.data.createdBy == request.auth.uid || (request.resource.data.assigneeIds is list && request.auth.uid in request.resource.data.assigneeIds) || request.resource.data.assigneeId == request.auth.uid);
      allow update: if isMember() && (isPrivileged() || resource.data.createdBy == request.auth.uid || request.resource.data.createdBy == request.auth.uid || (resource.data.assigneeIds is list && request.auth.uid in resource.data.assigneeIds) || (request.resource.data.assigneeIds is list && request.auth.uid in request.resource.data.assigneeIds) || resource.data.assigneeId == request.auth.uid || request.resource.data.assigneeId == request.auth.uid);
      allow delete: if isAdmin();
      match /comments/{commentId} {
        allow read, create: if canReadTask(taskId);
        allow update, delete: if canReadTask(taskId) && (resource.data.authorId == request.auth.uid || isPrivileged());
      }
      match /checklist/{itemId} {
        allow read, create, update, delete: if canReadTask(taskId);
      }
      match /activity/{activityId} {
        allow read, create: if canReadTask(taskId);
        allow update, delete: if canReadTask(taskId) && isPrivileged();
      }
    }
    match /projects/{projectId} { allow read: if isMember(); allow create, update: if isPrivileged(); allow delete: if isAdmin(); }
    match /projects/{projectId}/members/{memberId} { allow read: if isMember(); allow create, update, delete: if isPrivileged(); }
    match /projects/{projectId}/activity/{activityId} { allow read, create: if isMember(); allow update, delete: if isPrivileged(); }
    match /notifications/{userId} { allow read, create, update, delete: if signedIn() && (request.auth.uid == userId || isPrivileged()); match /items/{notificationId} { allow read, create, update, delete: if signedIn() && (request.auth.uid == userId || isPrivileged()); } }
    match /departments/{departmentId} { allow read: if isMember(); allow create, update: if isPrivileged(); allow delete: if isAdmin(); }
    match /roles/{roleId} { allow read: if isMember(); allow create, update, delete: if isAdmin(); }
    match /documents/{documentId} { allow read: if isMember(); allow create, update: if isPrivileged(); allow delete: if isAdmin(); }
    match /system/{documentId} { allow read, create, update, delete: if isSystemAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
